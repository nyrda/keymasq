#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v systemd-sysusers >/dev/null 2>&1; then
            systemd-sysusers /usr/lib/sysusers.d/keyforge.conf >/dev/null 2>&1 || true
        fi

        if command -v systemd-tmpfiles >/dev/null 2>&1; then
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/keyforge.conf >/dev/null 2>&1 || true
        fi

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=input --action=add >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=misc --action=add >/dev/null 2>&1 || true
        fi

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#
