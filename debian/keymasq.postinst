#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v systemd-sysusers >/dev/null 2>&1; then
            systemd-sysusers /usr/lib/sysusers.d/keymasq.conf >/dev/null 2>&1 || true
        fi

        if command -v systemd-tmpfiles >/dev/null 2>&1; then
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/keymasq.conf >/dev/null 2>&1 || true
        fi

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=input --action=add >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=misc --action=add >/dev/null 2>&1 || true
        fi

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi

        if [ -n "${2:-}" ]; then
            if command -v deb-systemd-invoke >/dev/null 2>&1; then
                deb-systemd-invoke try-restart keymasqd.service >/dev/null 2>&1 || true
            fi
        fi

        find /usr/share/icons/hicolor -path '*/apps/tools.keymasq.keymasq.*' -exec touch {} + >/dev/null 2>&1 || true
        touch /usr/share/icons/hicolor >/dev/null 2>&1 || true
        touch /usr/share/applications/tools.keymasq.keymasq.desktop >/dev/null 2>&1 || true
        ;;
esac

#DEBHELPER#
