#!/bin/sh
set -e

# dh_installsystemd --no-start omits its remove-time stop in debhelper 13.24.
# Stop keymasqd and finish hardware recovery while the helper is installed. If
# recovery is incomplete, the helper fails and dpkg keeps the package.
if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop keymasqd.service >/dev/null || true
	/usr/bin/keymasq-helper prepare-removal
fi

#DEBHELPER#
