#!/usr/bin/make -f

export PYBUILD_NAME = keymasq
export PYBUILD_SYSTEM = pyproject

%:
	dh $@ --buildsystem=pybuild

execute_after_dh_install:
	set -eu; \
	for icon in assets/icons/tools.keymasq.keymasq-*.png; do \
		size="$${icon##*-}"; \
		size="$${size%.png}"; \
		install -Dm644 "$$icon" "debian/keymasq/usr/share/icons/hicolor/$${size}x$${size}/apps/tools.keymasq.keymasq.png"; \
	done
