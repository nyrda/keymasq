_ensure_security_policy() {
    if [ -f /etc/keyforge/security.toml ]; then
        chown root:root /etc/keyforge/security.toml 2>/dev/null || true
        chmod 644 /etc/keyforge/security.toml 2>/dev/null || true
        return
    fi

    if [ -f /usr/share/doc/keyforge/security.toml ]; then
        install -Dm644 /usr/share/doc/keyforge/security.toml /etc/keyforge/security.toml
        chown root:root /etc/keyforge/security.toml 2>/dev/null || true
        return
    fi

install -Dm644 /dev/stdin /etc/keyforge/security.toml <<'EOF'
daemon_allowed_uids = []
session_allowed_uids = []

[macro]
exec_timeout_max_ms = 30000

[recording_guard]
# Tier 1 (recommended): require unlock for capture and recording commands.
unlock_required = true
# Tier 2 (optional): require unlock for macro inspection/edit commands.
macro_edit_requires_unlock = false

[session_command_acl]
# Denylist syntax (optional): "!command", "-command", or "deny:command"
gui = []
cli = []

[daemon_command_acl]
session = []
EOF
    chown root:root /etc/keyforge/security.toml 2>/dev/null || true
}

post_install() {
    systemd-sysusers
    systemd-tmpfiles --create
    udevadm control --reload-rules
    udevadm trigger --subsystem-match=input --action=add
    udevadm trigger --subsystem-match=misc --action=add

    if [ -f /etc/systemd/system/keyforged.service ]; then
        echo ""
        echo "Warning: /etc/systemd/system/keyforged.service exists and overrides packaged unit."
        echo "If keyforged cannot access devices, run: sudo systemctl revert keyforged"
    fi

    _ensure_security_policy
    
    echo ""
    echo "Keyforge has been installed!"
    echo ""
    echo "A system user 'keyforge' has been created for the daemon."
    echo ""
    echo "Security defaults use socket UID checks and command ACL policy."
    echo "Policy file: /etc/keyforge/security.toml"
    echo ""
    echo "To use Keyforge:"
    echo "  1. Enable the daemon:"
    echo "       sudo systemctl enable --now keyforged"
    echo ""
    echo "  2. Enable the session manager:"
    echo "       systemctl --user enable --now keyforge-session"
    echo ""
    echo "  3. Launch Keyforge:"
    echo "       keyforge"
    echo ""
    echo "Configuration: ~/.config/keyforge/"
    echo "Documentation:  https://github.com/nyrda/keyforge"
}

post_upgrade() {
    systemd-sysusers
    systemd-tmpfiles --create
    udevadm control --reload-rules
    udevadm trigger --subsystem-match=input --action=add
    udevadm trigger --subsystem-match=misc --action=add

    if [ -f /etc/systemd/system/keyforged.service ]; then
        echo ""
        echo "Warning: /etc/systemd/system/keyforged.service exists and overrides packaged unit."
        echo "If keyforged cannot access devices, run: sudo systemctl revert keyforged"
    fi
    _ensure_security_policy
    echo ""
    echo "Keyforge has been upgraded!"
    echo ""
    echo "Security policy uses UID/ACL controls; verify /etc/keyforge/security.toml"
    echo "If session cannot connect to daemon, verify runtime socket policy in /etc/keyforge/security.toml"
    echo "Restart services to apply changes:"
    echo "  sudo systemctl restart keyforged"
    echo "  systemctl --user restart keyforge-session"
}

post_remove() {
    echo ""
    echo "Keyforge has been removed."
    echo ""
    echo "The 'keyforge' user and group have been preserved."
    echo "To remove them, run:"
    echo "  sudo userdel keyforge"
    echo "  sudo groupdel keyforge"
    echo ""
    echo "Configuration files remain in: ~/.config/keyforge/"
}
