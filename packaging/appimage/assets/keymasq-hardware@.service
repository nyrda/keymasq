[Unit]
Description=Keymasq privileged hardware operation
BindsTo=keymasqd.service
After=keymasqd.service

[Service]
Type=oneshot
ExecStart=/opt/keymasq/bin/keymasq-record hardware-operation %i
TimeoutStartSec=60
TimeoutStopSec=2
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=keymasq-masking
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=keymasq-masking
StateDirectoryMode=0755
ReadWritePaths=/run /var/lib/keymasq-masking
