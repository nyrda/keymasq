[Unit]
Description=Keymasq Hardware Masking and Recovery
After=systemd-udevd.service systemd-udev-trigger.service
Before=keymasqd.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=20
ExecStart=/opt/keymasq/bin/keymasq-maskd
ExecStopPost=/opt/keymasq/bin/keymasq-maskd --recover-offline
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=keymasq-masking
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=keymasq-masking
StateDirectoryMode=0755
# Recovery must see /run/keymasq even when keymasqd recreates it after a crash.
ReadWritePaths=/run /var/lib/keymasq-masking

[Install]
WantedBy=multi-user.target
