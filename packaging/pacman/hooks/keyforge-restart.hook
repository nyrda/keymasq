# Optional pacman hook for Keyforge upgrades.
#
# Purpose:
#   Restart keyforged and keyforge-session automatically after keyforge upgrades.
#
# Install:
#   sudo install -Dm644 packaging/pacman/hooks/keyforge-restart.hook \
#     /etc/pacman.d/hooks/90-keyforge-restart.hook

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = keyforge

[Action]
Description = Restarting keyforge services after keyforge upgrade
When = PostTransaction
Exec = /usr/lib/keyforge/restart-services.sh
