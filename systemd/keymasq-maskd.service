[Unit]
Description=Keymasq Hardware Masking and Recovery
After=systemd-udevd.service systemd-udev-trigger.service
Before=keymasqd.service

[Service]
Type=notify
WatchdogSec=20
ExecStart=/usr/bin/keymasq-maskd
ExecStopPost=/usr/bin/keymasq-maskd --recover-offline
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=keymasq-masking
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=keymasq-masking
StateDirectoryMode=0755
# keymasqd recreates /run/keymasq after crashes; recovery must see the new
# directory rather than a bind mount of the old runtime directory.
ReadWritePaths=/run /var/lib/keymasq-masking

[Install]
WantedBy=multi-user.target
