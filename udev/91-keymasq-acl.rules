# Keymasq ACL rules
# Keep vendor group/mode handling intact and grant daemon access via ACL.

# uinput access for virtual device creation
ACTION=="add|change", KERNEL=="uinput", GROUP="input", MODE="0660", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/%k"

# input event devices across all drivers (including vendor-managed groups)
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/input/%k"
