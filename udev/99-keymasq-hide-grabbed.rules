# Final hide for grabbed physical gamepad sources after later input rules run.
# Hidden nodes are reset to root:root 0600 with the keymasq ACL re-granted.
# keymasqd opens a source before hiding it and keeps that handle, so the reset
# never affects a grabbed node; a keymasq-hardware@ root job runs the
# `udevadm trigger` that re-evaluates these rules when a flag changes.

ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", TEST=="/run/keymasq/hidden/%k", ENV{ID_INPUT_JOYSTICK}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/input/%k", RUN+="/usr/bin/chmod 0600 /dev/input/%k", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/input/%k"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="js*",    TEST=="/run/keymasq/hidden/%k", ENV{ID_INPUT_JOYSTICK}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/input/%k", RUN+="/usr/bin/chmod 0600 /dev/input/%k", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/input/%k"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="?*", ATTRS{id/vendor}=="?*", ATTRS{id/product}=="?*", ATTRS{phys}!="py-evdev-uinput", TEST=="/run/keymasq/hidden-hardware/%s{id/vendor}:%s{id/product}", ENV{ID_INPUT_JOYSTICK}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/input/%k", RUN+="/usr/bin/chmod 0600 /dev/input/%k", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/input/%k"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="js*",    ATTRS{id/vendor}=="?*", ATTRS{id/product}=="?*", ATTRS{phys}!="py-evdev-uinput", TEST=="/run/keymasq/hidden-hardware/%s{id/vendor}:%s{id/product}", ENV{ID_INPUT_JOYSTICK}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/input/%k", RUN+="/usr/bin/chmod 0600 /dev/input/%k", RUN+="/usr/bin/setfacl -m u:keymasq:rw /dev/input/%k"
